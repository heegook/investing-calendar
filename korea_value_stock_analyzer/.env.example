# Korea Value Stock Analyzer - API 키 설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채움 (.env 는 git에 커밋되지 않음)

# [필수] 금융감독원 OpenDART API 인증키 (https://opendart.fss.or.kr 에서 무료 발급)
#  - 재무제표, 주식총수·자기주식, 정기보고서 목록 수집에 사용
#  - 미설정 시 재무제표 기반 지표는 모두 null(FAILED: NO_API_KEY)로 처리되며 임의로 채우지 않음
DART_API_KEY=

# [선택] 한국거래소 정보데이터시스템(data.krx.co.kr) 회원 계정
#  - 설정 시 pykrx를 통해 KRX 공식 데이터로 전종목 종가·상장주식수를 수집함(신뢰도 HIGH)
#  - 미설정 시 KRX 전종목 시세 스냅샷(FinanceDataReader 캐시 경유, 신뢰도 MEDIUM)을 사용함
KRX_ID=
KRX_PW=

# [선택] 뉴스 검색 API (STEP 7 경영 리스크 조사에서 사용 예정)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
